# Backend environment for DineLink OS hotel room service
# Copy this file to `.env` for local development.

# Server port
PORT=5000

# MongoDB Atlas connection string. Preferred by the backend.
ATLASDB_URL=mongodb+srv://username:password@cluster.mongodb.net/dinelink-os?retryWrites=true&w=majority

# JWT signing secret. Replace in real deployments.
JWT_SECRET=replace_this_with_a_long_random_secret

# Frontend origin allowed by CORS and Socket.IO.
# For production, set this to your deployed frontend URL.
CLIENT_URL=http://localhost:5173

# Optional alias supported by server.js
FRONTEND_URL=http://localhost:5173

# Optional comma-separated list for multiple frontend domains.
# Example: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=

