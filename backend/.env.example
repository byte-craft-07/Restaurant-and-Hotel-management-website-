# Backend environment for DineLink OS
# Copy this file to `.env` for local development.

# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/dinelink-os

# JWT signing secret. Replace in real deployments.
JWT_SECRET=replace_this_with_a_long_random_secret

# Frontend origin allowed by CORS and Socket.IO
CLIENT_URL=http://localhost:5173

# Optional alias supported by server.js
FRONTEND_URL=http://localhost:5173

