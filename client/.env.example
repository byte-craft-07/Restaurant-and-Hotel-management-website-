# Frontend environment for DineLink OS
# Copy this file to `.env` for local development.

# Express API base URL. Keep `/api` at the end.
# Production backend used by the deployed frontend.
VITE_API_URL=https://restaurant-and-hotel-management-website.onrender.com/api

# Socket.IO server URL, without `/api`.
# Render Socket.IO backend, without `/api`.
VITE_SOCKET_URL=https://restaurant-and-hotel-management-website.onrender.com

# Optional AI endpoint for future backend/OpenAI integration.
# Leave empty to use the built-in local menu-aware fallback parser.
VITE_AI_ORDER_ENDPOINT=

# Demo safety mode lets `/qr/demo-room-101`, `/menu`, and `/kitchen`
# stay presentable even if the backend is unavailable.
VITE_ENABLE_DEMO_MODE=true
